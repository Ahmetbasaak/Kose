// Cloudflare Worker: serves dist/ as static assets (unknown paths → index.html for app routes)
// and runs worker/index.ts only for /api/* (anonymous usage stats). Headers: public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kose",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Created automatically on first write; free tier. Nothing personal is ever written.
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "timekeepera" }],
}
